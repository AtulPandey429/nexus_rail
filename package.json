{
  "name": "nexus-rail-monorepo",
  "version": "1.0.0",
  "packageManager": "pnpm@10.12.4",
  "private": true,
  "type": "module",
  "description": "NexusRail — Flagship Multi-Rail Commerce & AI Agent Desk Monorepo",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "pnpm --filter @nexusrail/api dev",
    "dev:web": "pnpm --filter @nexusrail/web dev",
    "build:shared": "pnpm --filter @nexusrail/shared build",
    "build:api": "pnpm --filter @nexusrail/api build",
    "build:web": "pnpm --filter @nexusrail/web build",
    "build": "pnpm --filter @nexusrail/shared build && pnpm --filter @nexusrail/api build && pnpm --filter @nexusrail/web build",
    "test": "pnpm --filter @nexusrail/api test"
  },
  "devDependencies": {
    "next": "^15.2.3",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.3",
    "mongodb": "^7.7.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
