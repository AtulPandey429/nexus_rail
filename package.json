{
  "name": "nexus-rail-monorepo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "NexusRail — Flagship Multi-Rail Commerce & AI Agent Desk Monorepo",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm run dev --workspace=@nexusrail/api",
    "dev:web": "npm run dev --workspace=@nexusrail/web",
    "build:shared": "npm run build --workspace=@nexusrail/shared",
    "build:api": "npm run build --workspace=@nexusrail/api",
    "build:web": "npm run build --workspace=@nexusrail/web",
    "build": "npm run build:shared && npm run build:api && npm run build:web",
    "start:api": "npm run start --workspace=@nexusrail/api",
    "start:web": "npm run start --workspace=@nexusrail/web",
    "test": "npm run test --workspace=@nexusrail/api"
  },
  "devDependencies": {
    "next": "^15.2.3",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.3",
    "mongodb": "^7.7.0"
  }
}
