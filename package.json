{
  "name": "nexus-rail-monorepo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "NexusRail — Clean Frontend & Backend Multi-Rail Commerce Platform",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev:frontend": "npm run dev --workspace=@nexusrail/frontend",
    "dev:backend": "npm run dev --workspace=@nexusrail/backend",
    "dev:web": "npm run dev:frontend",
    "dev:api": "npm run dev:backend",
    "build:frontend": "npm run build --workspace=@nexusrail/frontend",
    "build:backend": "npm run build --workspace=@nexusrail/backend",
    "build:shared": "node -e \"console.log('Shared types embedded directly in frontend/src/types and backend/src/types')\"",
    "build:web": "npm run build:frontend",
    "build:api": "npm run build:backend",
    "build": "npm run build:backend && npm run build:frontend",
    "start:frontend": "npm run start --workspace=@nexusrail/frontend",
    "start:backend": "npm run start --workspace=@nexusrail/backend",
    "start:web": "npm run start:frontend",
    "start:api": "npm run start:backend",
    "test": "npm run test --workspace=@nexusrail/backend"
  },
  "devDependencies": {
    "next": "^15.2.3",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "mongodb": "^7.7.0"
  }
}
