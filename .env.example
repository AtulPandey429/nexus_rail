# One code path. Development and production use the same variables.
# Development values are the provider's test credentials and test networks.
# Production swaps the values below. Do not add a second implementation.

PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000
APP_URL=http://localhost:3000
API_SERVER_URL=http://localhost:4000

# Required. Signs session tokens. No default in source.
JWT_SECRET=

# Primary Database (MongoDB Atlas)
# Serves users, products, orders, cart_items, wallet_ledger, proposals, and traces.
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.n4jez90.mongodb.net/nexusrail?retryWrites=true&w=majority

# Supabase Postgres. Optional secondary integration.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe. Development: sk_test_... and the matching whsec_ from `stripe listen`.
# Production: sk_live_... and the live endpoint secret for POST /api/v1/webhooks/stripe.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Groq chat completions. Required for the assistant and catalog guide.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# CoinGecko. Optional. The public API is used when this is empty.
# A failed call with no cached quote returns an error.
COINGECKO_API_KEY=

# Stellar Horizon & Hot Wallet Vault
HORIZON_URL=https://horizon-testnet.stellar.org
STELLAR_MERCHANT_PUBLIC_KEY=
STELLAR_HOT_WALLET_SECRET=

# XRPL Altnet & Hot Wallet Vault
XRPL_WSS=wss://s.altnet.rippletest.net:51233
XRPL_MERCHANT_ADDRESS=
XRPL_HOT_WALLET_SEED=

# Pinata. The CID stored on an order is the IpfsHash Pinata returns.
PINATA_JWT=

# Apply supabase/migrations/001_nexusrail_schema.sql
# then supabase/migrations/002_live_commerce.sql
# Set a user's role to admin in public.users. Registration always creates role user.
