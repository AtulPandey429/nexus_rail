# NexusRail Monorepo Environment Template ($0.00 Free Tier)

# Backend API Configuration
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# Supabase PostgreSQL Database (Free Tier)
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Upstash Redis Caching & Proposal Locks (Free Tier)
UPSTASH_REDIS_REST_URL=https://your-redis-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-redis-token

# AI LLM Provider Keys (Free Tier)
GEMINI_API_KEY=your-gemini-api-key
GROQ_API_KEY=your-groq-api-key

# Stripe Checkout (Test Mode)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret

# Crypto Testnets
XRPL_TESTNET_WSS=wss://s.altnet.rippletest.net:51233
STELLAR_HORIZON_TESTNET_URL=https://horizon-testnet.stellar.org
