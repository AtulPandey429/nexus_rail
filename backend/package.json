{
  "name": "@nexusrail/backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "postbuild": "node -e \"try{if(process.env.RENDER||require('fs').existsSync('/opt/render')){const fs=require('fs');fs.mkdirSync('../apps/api',{recursive:true});fs.writeFileSync('../apps/api/package.json',JSON.stringify({name:'@nexusrail/api',version:'1.0.0',private:true,type:'module',scripts:{start:'node ../../backend/dist/server.js'}},null,2));if(fs.existsSync('../package.json')){const pkg=JSON.parse(fs.readFileSync('../package.json','utf8'));if(Array.isArray(pkg.workspaces)&&!pkg.workspaces.includes('apps/api')){pkg.workspaces.push('apps/api');fs.writeFileSync('../package.json',JSON.stringify(pkg,null,2));}}}}catch{}\"",
    "test": "node --import tsx --test --test-reporter spec \"test/**/*.test.ts\"",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "@stellar/stellar-sdk": "^13.3.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "ethers": "^6.17.0",
    "express": "^4.21.2",
    "mongodb": "^7.7.0",
    "stripe": "^18.5.0",
    "xrpl": "^4.7.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
